        "Transforms": [ { "PathRemovePrefix": "" } ]
      },

      "kyc-route": {
        "ClusterId": "kyc-cluster",
        "Match": { "Path": "/api/kyc/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "" } ]
