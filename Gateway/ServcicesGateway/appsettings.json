        "Transforms": [ { "PathRemovePrefix": "" } ]
      }

    },
    "Clusters": {

      "identity-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://identityservice" }
        }
      },

      "kyc-cluster": {
        "Destinations": {
