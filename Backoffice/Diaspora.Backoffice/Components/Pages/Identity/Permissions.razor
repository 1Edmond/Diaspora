@page "/identity/permissions"
@attribute [Authorize]
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime

<PageTitle>Permissions | Diaspora Backoffice</PageTitle>

<PageBreadcrumb Title="Gestion des Permissions" SubTitle="Permissions granulaires du système" />

<div class="row">
    <div class="col-12">
        <div class="page-title-box">
            <div class="page-title-right">
                <button class="btn btn-success" @onclick="ShowCreateModal">
                    <i class="ti ti-plus me-1"></i> Nouvelle Permission
                </button>
            </div>
            <h4 class="page-title">
                <i class="ti ti-shield-lock me-2"></i>Permissions Système
            </h4>
        </div>
    </div>
</div>

<!-- Service Health -->
<div class="row mb-3">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="avatar-sm rounded-circle @(_serviceHealth ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                            <i class="ti @(_serviceHealth ? "ti-check" : "ti-x") fs-24"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h5 class="mb-1">Service Identity</h5>
                        <p class="text-muted mb-0">
                            @if (_serviceHealth)
                            {
                                <span class="text-success"><i class="ti ti-circle-filled me-1"></i>En ligne</span>
                            }
                            else
                            {
                                <span class="text-danger"><i class="ti ti-circle-filled me-1"></i>Hors ligne</span>
                            }
                            <span class="ms-2">Dernière vérification: @_lastHealthCheck?.ToString("HH:mm:ss")</span>
                        </p>
                    </div>
                    <div class="flex-shrink-0">
                        <button class="btn btn-outline-primary" @onclick="CheckServiceHealth">
                            <i class="ti ti-refresh me-1"></i> Vérifier
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Permissions by Service -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <ul class="nav nav-tabs card-header-tabs">
                    @foreach (var service in _permissionsByService.Keys)
                    {
                        <li class="nav-item">
                            <button class="nav-link @(_activeService == service ? "active" : "")" 
                                    @onclick='() => SwitchService(service)'>
                                <i class="ti ti-apps me-1"></i> @service
                                <span class="badge bg-secondary ms-1">@_permissionsByService[service].Count</span>
                            </button>
                        </li>
                    }
                </ul>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-centered table-hover">
                        <thead>
                            <tr>
                                <th>Code Permission</th>
                                <th>Nom</th>
                                <th>Description</th>
                                <th>Statut</th>
                                <th>Rôles associés</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_permissionsByService.ContainsKey(_activeService))
                            {
                                @foreach (var perm in _permissionsByService[_activeService])
                                {
                                    <tr>
                                        <td><code>@perm.Code</code></td>
                                        <td>@perm.Name</td>
                                        <td>@perm.Description</td>
                                        <td>
                                            @if (perm.IsActive)
                                            {
                                                <span class="badge bg-success">Actif</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactif</span>
                                            }
                                        </td>
                                        <td>
                                            @foreach (var role in perm.Roles.Take(2))
                                            {
                                                <span class="badge bg-primary me-1">@role</span>
                                            }
                                            @if (perm.Roles.Count > 2)
                                            {
                                                <span class="badge bg-secondary">+@(perm.Roles.Count - 2)</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <button class="btn btn-sm btn-outline-primary" @onclick="() => EditPermission(perm)">
                                                    <i class="ti ti-edit"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePermission(perm.Id)">
                                                    <i class="ti ti-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Permission Checker -->
<div class="row mt-4">
    <div class="col-xl-6">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">
                    <i class="ti ti-search me-2"></i>Vérificateur de Permissions
                </h4>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Utilisateur</label>
                    <select class="form-select" @bind="_checkUserId">
                        <option value="">Sélectionner un utilisateur</option>
                        @foreach (var user in _users)
                        {
                            <option value="@user.Id">@user.Email</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Permission</label>
                    <select class="form-select" @bind="_checkPermission">
                        <option value="">Sélectionner une permission</option>
                        @foreach (var perm in _allPermissions)
                        {
                            <option value="@perm.Code">@perm.Code - @perm.Name</option>
                        }
                    </select>
                </div>
                <button class="btn btn-primary" @onclick="CheckPermission" disabled="@(!CanCheckPermission())">
                    <i class="ti ti-check me-1"></i> Vérifier l'accès
                </button>
                
                @if (_permissionCheckResult != null)
                {
                    <div class="alert mt-3 @(_permissionCheckResult.HasAccess ? "alert-success" : "alert-danger")">
                        <i class="ti @(_permissionCheckResult.HasAccess ? "ti-check" : "ti-x") me-2"></i>
                        @_permissionCheckResult.Message
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">
                    <i class="ti ti-user-check me-2"></i>Permissions d'un Utilisateur
                </h4>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Sélectionner un utilisateur</label>
                    <select class="form-select" @bind="_selectedUserId" @bind:after="LoadUserPermissions">
                        <option value="">Choisir...</option>
                        @foreach (var user in _users)
                        {
                            <option value="@user.Id">@user.Email</option>
                        }
                    </select>
                </div>
                
                @if (_userPermissions != null)
                {
                    <h6>Rôles :</h6>
                    <div class="mb-3">
                        @foreach (var role in _userPermissions.Roles)
                        {
                            <span class="badge bg-primary me-1">@role</span>
                        }
                    </div>
                    
                    <h6>Permissions directes :</h6>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var perm in _userPermissions.Permissions)
                        {
                            <span class="badge bg-info">@perm</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Create/Edit Modal -->
@if (_showModal)
{
    <div class="modal fade show" style="display: block;" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_isEditing ? "Modifier" : "Créer") une Permission</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="_permissionModel" OnValidSubmit="SavePermission">
                    <div class="modal-body">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label">Code *</label>
                            <InputText @bind-Value="_permissionModel.Code" class="form-control" placeholder="ex: Users.Create" />
                            <ValidationMessage For="() => _permissionModel.Code" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Nom *</label>
                            <InputText @bind-Value="_permissionModel.Name" class="form-control" />
                            <ValidationMessage For="() => _permissionModel.Name" class="text-danger" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <InputTextArea @bind-Value="_permissionModel.Description" class="form-control" rows="2" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Service</label>
                            <InputText @bind-Value="_permissionModel.Service" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <div class="form-check">
                                <InputCheckbox @bind-Value="_permissionModel.IsActive" class="form-check-input" id="isActive" />
                                <label class="form-check-label" for="isActive">Actif</label>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Annuler</button>
                        <button type="submit" class="btn btn-primary">@(_isEditing ? "Mettre à jour" : "Créer")</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private HttpClient _client = default!;
    private bool _serviceHealth = true;
    private DateTime? _lastHealthCheck;
    private string _activeService = "Identity";
    
    private Dictionary<string, List<PermissionViewModel>> _permissionsByService = new();
    private List<PermissionViewModel> _allPermissions = new();
    private List<UserViewModel> _users = new();
    
    // Permission checker
    private string _checkUserId = "";
    private string _checkPermission = "";
    private PermissionCheckResult? _permissionCheckResult;
    
    // User permissions viewer
    private string _selectedUserId = "";
    private UserPermissionsViewModel? _userPermissions;
    
    // Modal
    private bool _showModal = false;
    private bool _isEditing = false;
    private PermissionModel _permissionModel = new();

    protected override void OnInitialized()
    {
        _client = HttpClientFactory.CreateClient("GatewayClient");
    }

    protected override async Task OnInitializedAsync()
    {
        await CheckServiceHealth();
        await LoadPermissions();
        await LoadUsers();
    }

    private async Task CheckServiceHealth()
    {
        try
        {
            var response = await _client.GetAsync("api/auth/health");
            _serviceHealth = response.IsSuccessStatusCode;
            _lastHealthCheck = DateTime.Now;
        }
        catch
        {
            _serviceHealth = false;
            _lastHealthCheck = DateTime.Now;
        }
    }

    private async Task LoadPermissions()
    {
        // Mock data for permissions
        _permissionsByService = new Dictionary<string, List<PermissionViewModel>>
        {
            ["Identity"] = new List<PermissionViewModel>
            {
                new PermissionViewModel { Id = Guid.NewGuid(), Code = "Users.View", Name = "Voir utilisateurs", Description = "Consulter la liste des utilisateurs", Service = "Identity", IsActive = true, Roles = new List<string> { "Admin", "Moderator" } },
                new PermissionViewModel { Id = Guid.NewGuid(), Code = "Users.Create", Name = "Créer utilisateurs", Description = "Créer de nouveaux utilisateurs", Service = "Identity", IsActive = true, Roles = new List<string> { "Admin" } },
                new PermissionViewModel { Id = Guid.NewGuid(), Code = "Users.Update", Name = "Modifier utilisateurs", Description = "Modifier les informations utilisateurs", Service = "Identity", IsActive = true, Roles = new List<string> { "Admin" } },
                new PermissionViewModel { Id = Guid.NewGuid(), Code = "Users.Delete", Name = "Supprimer utilisateurs", Description = "Supprimer des utilisateurs", Service = "Identity", IsActive = true, Roles = new List<string> { "Admin" } },
                new PermissionViewModel { Id = Guid.NewGuid(), Code = "Roles.Manage", Name = "Gérer les rôles", Description = "Créer et modifier les rôles", Service = "Identity", IsActive = true, Roles = new List<string> { "Admin" } },
                new PermissionViewModel { Id = Guid.NewGuid(), Code = "Permissions.Manage", Name = "Gérer les permissions", Description = "Gérer les permissions système", Service = "Identity", IsActive = true, Roles = new List<string> { "Admin" } }
            },
            ["Profile"] = new List<PermissionViewModel>
            {
                new PermissionViewModel { Id = Guid.NewGuid(), Code = "Profiles.View", Name = "Voir profils", Description = "Consulter les profils", Service = "Profile", IsActive = true, Roles = new List<string> { "Admin", "Moderator" } },
                new PermissionViewModel { Id = Guid.NewGuid(), Code = "Profiles.Verify", Name = "Vérifier profils", Description = "Valider les profils internes", Service = "Profile", IsActive = true, Roles = new List<string> { "Admin" } }
            },
            ["Wallet"] = new List<PermissionViewModel>
            {
                new PermissionViewModel { Id = Guid.NewGuid(), Code = "Wallet.Deposit", Name = "Déposer", Description = "Effectuer des dépôts", Service = "Wallet", IsActive = true, Roles = new List<string> { "Admin" } },
                new PermissionViewModel { Id = Guid.NewGuid(), Code = "Wallet.Transfer", Name = "Transférer", Description = "Effectuer des transferts", Service = "Wallet", IsActive = true, Roles = new List<string> { "Admin", "User" } }
            },
            ["Document"] = new List<PermissionViewModel>
            {
                new PermissionViewModel { Id = Guid.NewGuid(), Code = "Documents.View", Name = "Voir documents", Description = "Consulter les documents", Service = "Document", IsActive = true, Roles = new List<string> { "Admin", "Moderator" } },
                new PermissionViewModel { Id = Guid.NewGuid(), Code = "Documents.Validate", Name = "Valider documents", Description = "Valider ou rejeter les documents", Service = "Document", IsActive = true, Roles = new List<string> { "Admin" } }
            },
            ["Procedure"] = new List<PermissionViewModel>
            {
                new PermissionViewModel { Id = Guid.NewGuid(), Code = "Procedures.View", Name = "Voir procédures", Description = "Consulter les procédures", Service = "Procedure", IsActive = true, Roles = new List<string> { "Admin", "Moderator", "User" } },
                new PermissionViewModel { Id = Guid.NewGuid(), Code = "Procedures.Manage", Name = "Gérer procédures", Description = "Créer et modifier les procédures", Service = "Procedure", IsActive = true, Roles = new List<string> { "Admin" } }
            },
            ["Marketplace"] = new List<PermissionViewModel>
            {
                new PermissionViewModel { Id = Guid.NewGuid(), Code = "Marketplace.View", Name = "Voir marketplace", Description = "Consulter les services", Service = "Marketplace", IsActive = true, Roles = new List<string> { "Admin", "Moderator", "User" } },
                new PermissionViewModel { Id = Guid.NewGuid(), Code = "Marketplace.Moderate", Name = "Modérer services", Description = "Approuver ou rejeter les annonces", Service = "Marketplace", IsActive = true, Roles = new List<string> { "Admin", "Moderator" } }
            },
            ["KYC"] = new List<PermissionViewModel>
            {
                new PermissionViewModel { Id = Guid.NewGuid(), Code = "KYC.View", Name = "Voir KYC", Description = "Consulter les vérifications KYC", Service = "KYC", IsActive = true, Roles = new List<string> { "Admin", "Moderator" } },
                new PermissionViewModel { Id = Guid.NewGuid(), Code = "KYC.Approve", Name = "Approuver KYC", Description = "Approuver les vérifications KYC", Service = "KYC", IsActive = true, Roles = new List<string> { "Admin" } }
            }
        };
        
        _allPermissions = _permissionsByService.Values.SelectMany(p => p).ToList();
    }

    private async Task LoadUsers()
    {
        _users = new List<UserViewModel>
        {
            new UserViewModel { Id = Guid.NewGuid().ToString(), Email = "admin@diaspora.tg" },
            new UserViewModel { Id = Guid.NewGuid().ToString(), Email = "moderator@diaspora.tg" },
            new UserViewModel { Id = Guid.NewGuid().ToString(), Email = "user@diaspora.tg" }
        };
    }

    private void SwitchService(string service)
    {
        _activeService = service;
    }

    private bool CanCheckPermission()
    {
        return !string.IsNullOrEmpty(_checkUserId) && !string.IsNullOrEmpty(_checkPermission);
    }

    private async Task CheckPermission()
    {
        // Simulate API call
        _permissionCheckResult = new PermissionCheckResult
        {
            HasAccess = true,
            Message = $"L'utilisateur a la permission '{_checkPermission}'"
        };
    }

    private async Task LoadUserPermissions()
    {
        if (string.IsNullOrEmpty(_selectedUserId))
        {
            _userPermissions = null;
            return;
        }

        // Mock data
        _userPermissions = new UserPermissionsViewModel
        {
            UserId = _selectedUserId,
            Roles = new List<string> { "User", "Moderator" },
            Permissions = new List<string> { "Users.View", "Profiles.View", "Documents.View" }
        };
    }

    private void ShowCreateModal()
    {
        _isEditing = false;
        _permissionModel = new PermissionModel();
        _showModal = true;
    }

    private void EditPermission(PermissionViewModel perm)
    {
        _isEditing = true;
        _permissionModel = new PermissionModel
        {
            Code = perm.Code,
            Name = perm.Name,
            Description = perm.Description,
            Service = perm.Service,
            IsActive = perm.IsActive
        };
        _showModal = true;
    }

    private async Task DeletePermission(Guid id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Supprimer cette permission ?"))
            return;
        await JSRuntime.InvokeVoidAsync("alert", "Permission supprimée!");
    }

    private void CloseModal()
    {
        _showModal = false;
    }

    private async Task SavePermission()
    {
        // TODO: API call
        CloseModal();
        await LoadPermissions();
        await JSRuntime.InvokeVoidAsync("alert", _isEditing ? "Permission mise à jour!" : "Permission créée!");
    }

    // ViewModels
    public class PermissionViewModel
    {
        public Guid Id { get; set; }
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Service { get; set; } = string.Empty;
        public bool IsActive { get; set; }
        public List<string> Roles { get; set; } = new();
    }

    public class UserViewModel
    {
        public string Id { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
    }

    public class PermissionCheckResult
    {
        public bool HasAccess { get; set; }
        public string Message { get; set; } = string.Empty;
    }

    public class UserPermissionsViewModel
    {
        public string UserId { get; set; } = string.Empty;
        public List<string> Roles { get; set; } = new();
        public List<string> Permissions { get; set; } = new();
    }

    public class PermissionModel
    {
        [Required(ErrorMessage = "Le code est requis")]
        public string Code { get; set; } = string.Empty;
        
        [Required(ErrorMessage = "Le nom est requis")]
        public string Name { get; set; } = string.Empty;
        
        public string Description { get; set; } = string.Empty;
        public string Service { get; set; } = string.Empty;
        public bool IsActive { get; set; } = true;
    }
}
