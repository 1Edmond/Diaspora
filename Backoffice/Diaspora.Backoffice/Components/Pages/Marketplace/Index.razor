@page "/marketplace"
@attribute [Authorize]
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime

<PageTitle>Marketplace | Diaspora Backoffice</PageTitle>

<PageBreadcrumb Title="Gestion Marketplace" SubTitle="Services communautaires et modération" />

<!-- Stats -->
<div class="row mb-3">
    <div class="col-xl-3 col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="avatar-sm rounded-circle bg-primary-subtle text-primary">
                            <i class="ti ti-briefcase fs-24"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h5 class="mb-1">@_stats.TotalServices</h5>
                        <p class="text-muted mb-0">Services</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="avatar-sm rounded-circle bg-warning-subtle text-warning">
                            <i class="ti ti-clock fs-24"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h5 class="mb-1">@_stats.PendingReview</h5>
                        <p class="text-muted mb-0">En Attente</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="avatar-sm rounded-circle bg-success-subtle text-success">
                            <i class="ti ti-check fs-24"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h5 class="mb-1">@_stats.ActiveServices</h5>
                        <p class="text-muted mb-0">Actifs</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="avatar-sm rounded-circle bg-info-subtle text-info">
                            <i class="ti ti-shopping-cart fs-24"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h5 class="mb-1">@_stats.TotalRequests</h5>
                        <p class="text-muted mb-0">Demandes</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tabs -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <ul class="nav nav-tabs card-header-tabs">
                    <li class="nav-item">
                        <button class="nav-link @(_activeTab == "services" ? "active" : "")" @onclick='() => SwitchTab("services")'>
                            <i class="ti ti-briefcase me-1"></i> Services
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(_activeTab == "categories" ? "active" : "")" @onclick='() => SwitchTab("categories")'>
                            <i class="ti ti-category me-1"></i> Catégories
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(_activeTab == "requests" ? "active" : "")" @onclick='() => SwitchTab("requests")'>
                            <i class="ti ti-list me-1"></i> Demandes
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(_activeTab == "reviews" ? "active" : "")" @onclick='() => SwitchTab("reviews")'>
                            <i class="ti ti-star me-1"></i> Avis
                        </button>
                    </li>
                </ul>
            </div>
            <div class="card-body">
                @if (_activeTab == "services")
                {
                    <div class="d-flex justify-content-between mb-3">
                        <div class="d-flex gap-2">
                            <input type="text" class="form-control" placeholder="Rechercher..." style="width: 200px;" @bind="_searchTerm" />
                            <select class="form-select" style="width: 150px;" @bind="_categoryFilter">
                                <option value="">Toutes catégories</option>
                                @foreach (var cat in _categories)
                                {
                                    <option value="@cat.Name">@cat.Name</option>
                                }
                            </select>
                            <select class="form-select" style="width: 120px;" @bind="_statusFilter">
                                <option value="">Tous</option>
                                <option value="Pending">En attente</option>
                                <option value="Active">Actif</option>
                                <option value="Suspended">Suspendu</option>
                            </select>
                            <select class="form-select" style="width: 120px;" @bind="_priceFilter">
                                <option value="">Prix</option>
                                <option value="0-1000">0-1000</option>
                                <option value="1000-5000">1000-5000</option>
                                <option value="5000+">5000+</option>
                            </select>
                        </div>
                        <button class="btn btn-outline-secondary" @onclick="ResetFilters">
                            <i class="ti ti-filter-off"></i>
                        </button>
                    </div>
                    <div class="row">
                        @foreach (var service in GetFilteredServices())
                        {
                            <div class="col-md-6 col-xl-4 mb-3">
                                <div class="card h-100">
                                    <div class="card-header bg-light">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="badge @GetStatusBadge(service.Status)">@service.Status</span>
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-link" data-bs-toggle="dropdown">
                                                    <i class="ti ti-dots-vertical"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <li><a class="dropdown-item" href="#" @onclick="() => ViewService(service)"><i class="ti ti-eye me-1"></i> Voir</a></li>
                                                    @if (service.Status == "Pending")
                                                    {
                                                        <li><a class="dropdown-item text-success" href="#" @onclick="() => ApproveService(service.Id)"><i class="ti ti-check me-1"></i> Approuver</a></li>
                                                        <li><a class="dropdown-item text-danger" href="#" @onclick="() => ShowRejectModal(service)"><i class="ti ti-x me-1"></i> Rejeter</a></li>
                                                    }
                                                    @if (service.Status == "Active")
                                                    {
                                                        <li><a class="dropdown-item text-warning" href="#" @onclick="() => SuspendService(service.Id)"><i class="ti ti-lock me-1"></i> Suspendre</a></li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <h6 class="card-title">@service.Title</h6>
                                        <p class="text-muted small">@service.Description</p>
                                        <div class="d-flex justify-content-between align-items-center mt-3">
                                            <span class="badge bg-info">@service.CategoryName</span>
                                            <h5 class="mb-0 text-primary">@service.Price.ToString("N0") RUB</h5>
                                        </div>
                                        <div class="mt-3">
                                            <small class="text-muted">
                                                <i class="ti ti-user me-1"></i> @service.ProviderName
                                            </small>
                                            <br />
                                            <small class="text-muted">
                                                <i class="ti ti-star me-1 text-warning"></i> @service.Rating (@service.ReviewCount avis)
                                            </small>
                                        </div>
                                    </div>
                                    <div class="card-footer bg-transparent">
                                        <div class="d-flex justify-content-between text-muted small">
                                            <span><i class="ti ti-eye me-1"></i> @service.ViewCount</span>
                                            <span><i class="ti ti-shopping-cart me-1"></i> @service.RequestCount</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (_activeTab == "categories")
                {
                    <div class="d-flex justify-content-between mb-3">
                        <button class="btn btn-success" @onclick="ShowCreateCategoryModal">
                            <i class="ti ti-plus me-1"></i> Nouvelle Catégorie
                        </button>
                    </div>
                    <div class="row">
                        @foreach (var cat in _categories)
                        {
                            <div class="col-md-4 mb-3">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <h6 class="card-title">
                                                    <i class="ti ti-category me-2"></i>@cat.Name
                                                </h6>
                                                <p class="text-muted small">@cat.Description</p>
                                                <span class="badge bg-primary">@cat.ServiceCount services</span>
                                            </div>
                                            <span class="badge @(cat.IsActive ? "bg-success" : "bg-secondary")">
                                                @(cat.IsActive ? "Actif" : "Inactif")
                                            </span>
                                        </div>
                                        <div class="mt-3 d-flex gap-1">
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => EditCategory(cat)">
                                                <i class="ti ti-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-warning" @onclick="() => ToggleCategoryStatus(cat.Id)">
                                                <i class="ti ti-power"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCategory(cat.Id)">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (_activeTab == "requests")
                {
                    <div class="table-responsive">
                        <table class="table table-centered table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Service</th>
                                    <th>Demandeur</th>
                                    <th>Fournisseur</th>
                                    <th>Prix</th>
                                    <th>Statut</th>
                                    <th>Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var req in _requests)
                                {
                                    <tr>
                                        <td><small>@req.Id.ToString()[..8]</small></td>
                                        <td>@req.ServiceTitle</td>
                                        <td>@req.RequesterName</td>
                                        <td>@req.ProviderName</td>
                                        <td>@req.Price.ToString("N0") RUB</td>
                                        <td><span class="badge @GetRequestStatusBadge(req.Status)">@req.Status</span></td>
                                        <td>@req.CreatedAt.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewRequest(req)">
                                                <i class="ti ti-eye"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (_activeTab == "reviews")
                {
                    <div class="d-flex justify-content-between mb-3">
                        <h5>Avis et évaluations</h5>
                        <select class="form-select" style="width: 150px;" @bind="_reviewFilter">
                            <option value="">Tous</option>
                            <option value="5">5 étoiles</option>
                            <option value="4">4 étoiles</option>
                            <option value="3">3 étoiles</option>
                            <option value="2">2 étoiles</option>
                            <option value="1">1 étoile</option>
                        </select>
                    </div>
                    <div class="row">
                        @foreach (var review in GetFilteredReviews())
                        {
                            <div class="col-md-6 mb-3">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <h6 class="card-title">@review.ServiceTitle</h6>
                                                <div class="mb-2">
                                                    @for (int i = 0; i < review.Rating; i++)
                                                    {
                                                        <i class="ti ti-star-filled text-warning"></i>
                                                    }
                                                    @for (int i = review.Rating; i < 5; i++)
                                                    {
                                                        <i class="ti ti-star text-muted"></i>
                                                    }
                                                </div>
                                                <p class="text-muted">@review.Comment</p>
                                                <small class="text-muted">
                                                    Par @review.ReviewerName le @review.CreatedAt.ToString("dd/MM/yyyy")
                                                </small>
                                            </div>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteReview(review.Id)">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (_showRejectModal && _selectedService != null)
{
    <div class="modal fade show" style="display: block;" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Rejeter le Service</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseRejectModal"></button>
                </div>
                <div class="modal-body">
                    <p>Service: <strong>@_selectedService.Title</strong></p>
                    <div class="mb-3">
                        <label class="form-label text-danger">Motif du rejet *</label>
                        <textarea class="form-control" rows="3" @bind="_rejectReason" placeholder="Expliquez pourquoi ce service est rejeté..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseRejectModal">Annuler</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmReject" disabled="@string.IsNullOrEmpty(_rejectReason)">
                        <i class="ti ti-x me-1"></i> Rejeter
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private HttpClient _client = default!;
    private string _activeTab = "services";
    private string _searchTerm = "";
    private string _categoryFilter = "";
    private string _statusFilter = "";
    private string _priceFilter = "";
    private string _reviewFilter = "";
    private MarketplaceStats _stats = new();

    private List<ServiceViewModel> _services = new();
    private List<CategoryViewModel> _categories = new();
    private List<RequestViewModel> _requests = new();
    private List<ReviewViewModel> _reviews = new();

    private bool _showRejectModal = false;
    private ServiceViewModel? _selectedService;
    private string _rejectReason = "";

    protected override void OnInitialized()
    {
        _client = HttpClientFactory.CreateClient("GatewayClient");
        LoadMockData();
    }

    private void LoadMockData()
    {
        _categories = new List<CategoryViewModel>
        {
            new CategoryViewModel { Id = Guid.NewGuid(), Name = "Logement", Description = "Location et colocation", ServiceCount = 45, IsActive = true },
            new CategoryViewModel { Id = Guid.NewGuid(), Name = "Traduction", Description = "Services de traduction", ServiceCount = 12, IsActive = true },
            new CategoryViewModel { Id = Guid.NewGuid(), Name = "Transport", Description = "Déplacements", ServiceCount = 28, IsActive = true },
            new CategoryViewModel { Id = Guid.NewGuid(), Name = "Cours", Description = "Soutien scolaire", ServiceCount = 56, IsActive = true }
        };

        _services = new List<ServiceViewModel>
        {
            new ServiceViewModel { Id = Guid.NewGuid(), Title = "Traduction FR-RU certifiée", Description = "Traduction officielle documents", CategoryName = "Traduction", ProviderName = "Koffi Mensah", Price = 1500, Status = "Pending", Rating = 4.5, ReviewCount = 12, ViewCount = 145, RequestCount = 8 },
            new ServiceViewModel { Id = Guid.NewGuid(), Title = "Location Appartement 2 pièces", Description = "Grand appartement centre-ville", CategoryName = "Logement", ProviderName = "Afi Kouassi", Price = 35000, Status = "Active", Rating = 4.8, ReviewCount = 23, ViewCount = 234, RequestCount = 15 },
            new ServiceViewModel { Id = Guid.NewGuid(), Title = "Cours de Russe débutant", Description = "Cours particuliers russe", CategoryName = "Cours", ProviderName = "Komi Agbé", Price = 800, Status = "Active", Rating = 5.0, ReviewCount = 8, ViewCount = 89, RequestCount = 5 },
            new ServiceViewModel { Id = Guid.NewGuid(), Title = "Transport aéroport", Description = "Navette aéroport Moscou", CategoryName = "Transport", ProviderName = "Amavi Kodjo", Price = 2500, Status = "Suspended", Rating = 3.5, ReviewCount = 5, ViewCount = 67, RequestCount = 3 }
        };

        _requests = new List<RequestViewModel>
        {
            new RequestViewModel { Id = Guid.NewGuid(), ServiceTitle = "Traduction FR-RU certifiée", RequesterName = "Koffi Mensah", ProviderName = "Afi Kouassi", Price = 1500, Status = "Pending", CreatedAt = DateTime.Now.AddDays(-2) },
            new RequestViewModel { Id = Guid.NewGuid(), ServiceTitle = "Location Appartement 2 pièces", RequesterName = "Komi Agbé", ProviderName = "Afi Kouassi", Price = 35000, Status = "Accepted", CreatedAt = DateTime.Now.AddDays(-5) },
            new RequestViewModel { Id = Guid.NewGuid(), ServiceTitle = "Cours de Russe débutant", RequesterName = "Amavi Kodjo", ProviderName = "Komi Agbé", Price = 800, Status = "Completed", CreatedAt = DateTime.Now.AddDays(-10) }
        };

        _reviews = new List<ReviewViewModel>
        {
            new ReviewViewModel { Id = Guid.NewGuid(), ServiceTitle = "Traduction FR-RU certifiée", ReviewerName = "Koffi Mensah", Rating = 5, Comment = "Excellent service, très professionnel", CreatedAt = DateTime.Now.AddDays(-5) },
            new ReviewViewModel { Id = Guid.NewGuid(), ServiceTitle = "Location Appartement 2 pièces", ReviewerName = "Komi Agbé", Rating = 4, Comment = "Très bon appartement, bien situé", CreatedAt = DateTime.Now.AddDays(-8) },
            new ReviewViewModel { Id = Guid.NewGuid(), ServiceTitle = "Cours de Russe débutant", ReviewerName = "Amavi Kodjo", Rating = 5, Comment = "Professeur patient et pédagogue", CreatedAt = DateTime.Now.AddDays(-12) }
        };

        CalculateStats();
    }

    private void CalculateStats()
    {
        _stats.TotalServices = _services.Count;
        _stats.PendingReview = _services.Count(s => s.Status == "Pending");
        _stats.ActiveServices = _services.Count(s => s.Status == "Active");
        _stats.TotalRequests = _requests.Count;
    }

    private void SwitchTab(string tab) => _activeTab = tab;

    private List<ServiceViewModel> GetFilteredServices()
    {
        var query = _services.AsQueryable();
        if (!string.IsNullOrEmpty(_searchTerm))
            query = query.Where(s => s.Title.Contains(_searchTerm) || s.Description.Contains(_searchTerm));
        if (!string.IsNullOrEmpty(_categoryFilter))
            query = query.Where(s => s.CategoryName == _categoryFilter);
        if (!string.IsNullOrEmpty(_statusFilter))
            query = query.Where(s => s.Status == _statusFilter);
        return query.ToList();
    }

    private List<ReviewViewModel> GetFilteredReviews()
    {
        if (string.IsNullOrEmpty(_reviewFilter))
            return _reviews;
        return _reviews.Where(r => r.Rating == int.Parse(_reviewFilter)).ToList();
    }

    private void ResetFilters()
    {
        _searchTerm = "";
        _categoryFilter = "";
        _statusFilter = "";
        _priceFilter = "";
    }

    private string GetStatusBadge(string status) => status switch
    {
        "Active" => "bg-success",
        "Pending" => "bg-warning",
        "Suspended" => "bg-danger",
        _ => "bg-secondary"
    };

    private string GetRequestStatusBadge(string status) => status switch
    {
        "Completed" => "bg-success",
        "Accepted" => "bg-info",
        "Pending" => "bg-warning",
        "Cancelled" => "bg-danger",
        _ => "bg-secondary"
    };

    private void ViewService(ServiceViewModel service) { }
    private async Task ApproveService(Guid id) { await JSRuntime.InvokeVoidAsync("alert", "Service approuvé!"); }
    private void ShowRejectModal(ServiceViewModel service) { _selectedService = service; _rejectReason = ""; _showRejectModal = true; }
    private void CloseRejectModal() { _showRejectModal = false; _selectedService = null; }
    private async Task ConfirmReject() { if (_selectedService != null && !string.IsNullOrEmpty(_rejectReason)) { await JSRuntime.InvokeVoidAsync("alert", $"Service rejeté: {_rejectReason}"); CloseRejectModal(); } }
    private async Task SuspendService(Guid id) { await JSRuntime.InvokeVoidAsync("alert", "Service suspendu!"); }
    private void ShowCreateCategoryModal() { }
    private void EditCategory(CategoryViewModel cat) { }
    private async Task ToggleCategoryStatus(Guid id) { await JSRuntime.InvokeVoidAsync("alert", "Statut catégorie modifié!"); }
    private async Task DeleteCategory(Guid id) { await JSRuntime.InvokeVoidAsync("alert", "Catégorie supprimée!"); }
    private void ViewRequest(RequestViewModel req) { }
    private async Task DeleteReview(Guid id) { await JSRuntime.InvokeVoidAsync("alert", "Avis supprimé!"); }

    public class MarketplaceStats
    {
        public int TotalServices { get; set; }
        public int PendingReview { get; set; }
        public int ActiveServices { get; set; }
        public int TotalRequests { get; set; }
    }

    public class ServiceViewModel
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string CategoryName { get; set; } = string.Empty;
        public string ProviderName { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public string Status { get; set; } = string.Empty;
        public double Rating { get; set; }
        public int ReviewCount { get; set; }
        public int ViewCount { get; set; }
        public int RequestCount { get; set; }
    }

    public class CategoryViewModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public int ServiceCount { get; set; }
        public bool IsActive { get; set; }
    }

    public class RequestViewModel
    {
        public Guid Id { get; set; }
        public string ServiceTitle { get; set; } = string.Empty;
        public string RequesterName { get; set; } = string.Empty;
        public string ProviderName { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public string Status { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
    }

    public class ReviewViewModel
    {
        public Guid Id { get; set; }
        public string ServiceTitle { get; set; } = string.Empty;
        public string ReviewerName { get; set; } = string.Empty;
        public int Rating { get; set; }
        public string Comment { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
    }
}
