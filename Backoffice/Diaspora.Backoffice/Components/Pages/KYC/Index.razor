@page "/kyc"
@attribute [Authorize]
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime

<PageTitle>KYC | Diaspora Backoffice</PageTitle>

<PageBreadcrumb Title="Vérification KYC" SubTitle="Validation des identités et documents" />

<!-- Stats -->
<div class="row mb-3">
    <div class="col-xl-3 col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="avatar-sm rounded-circle bg-warning-subtle text-warning">
                            <i class="ti ti-clock fs-24"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h5 class="mb-1">@_stats.Pending</h5>
                        <p class="text-muted mb-0">En Attente</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="avatar-sm rounded-circle bg-success-subtle text-success">
                            <i class="ti ti-check fs-24"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h5 class="mb-1">@_stats.Approved</h5>
                        <p class="text-muted mb-0">Approuvés</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="avatar-sm rounded-circle bg-danger-subtle text-danger">
                            <i class="ti ti-x fs-24"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h5 class="mb-1">@_stats.Rejected</h5>
                        <p class="text-muted mb-0">Rejetés</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="avatar-sm rounded-circle bg-info-subtle text-info">
                            <i class="ti ti-file fs-24"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h5 class="mb-1">@_stats.Total</h5>
                        <p class="text-muted mb-0">Total</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="row mb-3">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Statut</label>
                        <select class="form-select" @bind="_statusFilter" @bind:after="LoadKycVerifications">
                            <option value="">Tous</option>
                            <option value="Pending">En attente</option>
                            <option value="UnderReview">En révision</option>
                            <option value="Approved">Approuvé</option>
                            <option value="Rejected">Rejeté</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Niveau KYC</label>
                        <select class="form-select" @bind="_levelFilter" @bind:after="LoadKycVerifications">
                            <option value="">Tous</option>
                            <option value="None">Aucun</option>
                            <option value="Basic">Basique</option>
                            <option value="Full">Complet</option>
                        </select>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button class="btn btn-outline-secondary w-100" @onclick="ResetFilters">
                            <i class="ti ti-filter-off me-1"></i> Réinitialiser
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- KYC Table -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">Demandes de Vérification KYC</h4>
            </div>
            <div class="card-body">
                @if (_isLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary"></div>
                    </div>
                }
                else if (_kycVerifications.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="ti ti-file-check fs-48 text-muted"></i>
                        <p class="mt-3 text-muted">Aucune demande KYC trouvée</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-centered table-hover">
                            <thead>
                                <tr>
                                    <th>Utilisateur</th>
                                    <th>Email</th>
                                    <th>Niveau</th>
                                    <th>Documents</th>
                                    <th>Statut</th>
                                    <th>Soumis le</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var kyc in _kycVerifications)
                                {
                                    <tr>
                                        <td>@kyc.UserName</td>
                                        <td>@kyc.UserEmail</td>
                                        <td>
                                            <span class="badge @GetLevelBadge(kyc.Level)">@kyc.Level</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-info">@kyc.DocumentCount docs</span>
                                        </td>
                                        <td>
                                            <span class="badge @GetStatusBadge(kyc.Status)">@kyc.Status</span>
                                        </td>
                                        <td>@kyc.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewDetails(kyc)">
                                                    <i class="ti ti-eye"></i>
                                                </button>
                                                @if (kyc.Status == "Pending" || kyc.Status == "UnderReview")
                                                {
                                                    <button class="btn btn-sm btn-success" @onclick="() => ApproveKyc(kyc.Id)">
                                                        <i class="ti ti-check"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-danger" @onclick="() => RejectKyc(kyc.Id)">
                                                        <i class="ti ti-x"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private HttpClient _client = default!;
    private bool _isLoading = true;
    private List<KycVerificationViewModel> _kycVerifications = new();
    private KycStats _stats = new();

    private string _statusFilter = "";
    private string _levelFilter = "";

    protected override void OnInitialized()
    {
        _client = HttpClientFactory.CreateClient("GatewayClient");
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadKycVerifications();
    }

    private async Task LoadKycVerifications()
    {
        _isLoading = true;
        try
        {
            _kycVerifications = new List<KycVerificationViewModel>
            {
                new KycVerificationViewModel
                {
                    Id = Guid.NewGuid(),
                    UserId = Guid.NewGuid(),
                    UserName = "Koffi Mensah",
                    UserEmail = "koffi.mensah@email.com",
                    Level = "Full",
                    Status = "Pending",
                    DocumentCount = 3,
                    SubmittedAt = DateTime.Now.AddDays(-2)
                },
                new KycVerificationViewModel
                {
                    Id = Guid.NewGuid(),
                    UserId = Guid.NewGuid(),
                    UserName = "Afi Kouassi",
                    UserEmail = "afi.kouassi@email.com",
                    Level = "Basic",
                    Status = "UnderReview",
                    DocumentCount = 2,
                    SubmittedAt = DateTime.Now.AddDays(-1)
                },
                new KycVerificationViewModel
                {
                    Id = Guid.NewGuid(),
                    UserId = Guid.NewGuid(),
                    UserName = "Komi Agbé",
                    UserEmail = "komi.agbe@email.com",
                    Level = "Full",
                    Status = "Approved",
                    DocumentCount = 3,
                    SubmittedAt = DateTime.Now.AddDays(-5)
                }
            };

            CalculateStats();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Erreur: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void CalculateStats()
    {
        _stats.Pending = _kycVerifications.Count(k => k.Status == "Pending");
        _stats.Approved = _kycVerifications.Count(k => k.Status == "Approved");
        _stats.Rejected = _kycVerifications.Count(k => k.Status == "Rejected");
        _stats.Total = _kycVerifications.Count;
    }

    private async Task ResetFilters()
    {
        _statusFilter = "";
        _levelFilter = "";
        await LoadKycVerifications();
    }

    private string GetStatusBadge(string status)
    {
        return status switch
        {
            "Approved" => "bg-success",
            "Pending" => "bg-warning",
            "UnderReview" => "bg-info",
            "Rejected" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private string GetLevelBadge(string level)
    {
        return level switch
        {
            "Full" => "bg-success",
            "Basic" => "bg-info",
            "None" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    private void ViewDetails(KycVerificationViewModel kyc)
    {
        // Navigate to details
    }

    private async Task ApproveKyc(Guid id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Approuver cette vérification KYC ?"))
            return;
        await JSRuntime.InvokeVoidAsync("alert", "KYC approuvé!");
        await LoadKycVerifications();
    }

    private async Task RejectKyc(Guid id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Rejeter cette vérification KYC ?"))
            return;
        await JSRuntime.InvokeVoidAsync("alert", "KYC rejeté!");
        await LoadKycVerifications();
    }

    public class KycVerificationViewModel
    {
        public Guid Id { get; set; }
        public Guid UserId { get; set; }
        public string UserName { get; set; } = string.Empty;
        public string UserEmail { get; set; } = string.Empty;
        public string Level { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public int DocumentCount { get; set; }
        public DateTime SubmittedAt { get; set; }
    }

    public class KycStats
    {
        public int Pending { get; set; }
        public int Approved { get; set; }
        public int Rejected { get; set; }
        public int Total { get; set; }
    }
}
