@page "/wallet"
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Wallet Service | Diaspora Backoffice</PageTitle>

<div class="row">
    <div class="col-12">
        <div class="page-title-box">
            <div class="page-title-right">
                <a href="javascript: void(0);" class="btn btn-primary ms-2" data-bs-toggle="modal" data-bs-target="#depositModal">
                    <i class="ti ti-cash"></i> Deposit / Bourse
                </a>
                <a href="javascript: void(0);" class="btn btn-secondary ms-2" data-bs-toggle="modal" data-bs-target="#parametersModal">
                    <i class="ti ti-settings"></i> Configuration
                </a>
            </div>
            <h4 class="page-title">Wallet & Finance Administration</h4>
        </div>
    </div>
</div>

<div class="row">
    <!-- Transactions Overview -->
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-5">
                        <form class="d-flex">
                            <label class="col-form-label me-2">Profile ID Lookup:</label>
                            <input type="text" class="form-control form-control-sm w-50" placeholder="External Profile Guid...">
                            <button class="btn btn-sm btn-light ms-2" type="button"><i class="ti ti-search"></i></button>
                        </form>
                    </div>
                    <div class="col-md-7 text-end">
                        <div class="d-inline-block text-start me-3">
                            <h4 class="mb-0 text-success">350,000 ₽</h4>
                            <p class="text-muted mb-0 font-13">Total Volume (Today)</p>
                        </div>
                        <div class="d-inline-block text-start">
                            <h4 class="mb-0 text-primary">1,245</h4>
                            <p class="text-muted mb-0 font-13">Transactions</p>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-centered table-striped w-100 dt-responsive nowrap">
                        <thead>
                            <tr>
                                <th>Txn Hash</th>
                                <th>Date</th>
                                <th>Source Profile</th>
                                <th>Destination Profile</th>
                                <th>Amount</th>
                                <th>Type</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Dummy Data mapped to GetTransactionsQuery -->
                            <tr>
                                <td>TX-9A8B7C6D</td>
                                <td>15-Mar-2024 14:00</td>
                                <td>System (Admin)</td>
                                <td>Koffi Mensah (Profile ID)</td>
                                <td class="text-success fw-bold">+ 10,000 RUB</td>
                                <td>Bourse Deposit</td>
                                <td><span class="badge bg-success">Completed</span></td>
                            </tr>
                            <tr>
                                <td>TX-1F2E3D4C</td>
                                <td>15-Mar-2024 10:15</td>
                                <td>Koffi Mensah</td>
                                <td>Marketplace (Provider ID)</td>
                                <td class="text-danger fw-bold">- 1,500 RUB</td>
                                <td>Service Payment</td>
                                <td><span class="badge bg-success">Completed</span></td>
                            </tr>
                            <tr>
                                <td>TX-5B6N7M8L</td>
                                <td>14-Mar-2024 09:20</td>
                                <td>Koffi Mensah</td>
                                <td>Procedure (Embassy)</td>
                                <td class="text-danger fw-bold">- 2,500 RUB</td>
                                <td>Visa Renewal</td>
                                <td><span class="badge bg-success">Completed</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Deposit / Bourse Modal (Mapped to DepositCommand) -->
<div id="depositModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Deposit Funds (Admin)</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <form class="ps-3 pe-3" action="#">
                    <div class="mb-3">
                        <label class="form-label">Target External Profile ID *</label>
                        <input class="form-control" type="text" required placeholder="User Guid">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Amount (RUB) *</label>
                        <input class="form-control" type="number" step="0.01" min="1" value="0" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description / Reason *</label>
                        <input class="form-control" type="text" required placeholder="e.g. Allocation Bourse Mars 2024">
                    </div>
                    <div class="mb-3 text-center">
                        <button class="btn btn-success" type="submit"><i class="ti ti-cash"></i> Execute Deposit</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Wallet Parameters Modal (Mapped to UpdateWalletParameterCommand) -->
<div id="parametersModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Wallet Parameters Configuration</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Parameter Key</th>
                                <th>Description</th>
                                <th>Value</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Dummy Data mapped to GetAll Parameters Query -->
                            <tr>
                                <td>MarketplaceFeeRate</td>
                                <td>Percentage taken from marketplace txns</td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <input type="text" class="form-control" value="0.02">
                                        <span class="input-group-text">%</span>
                                    </div>
                                </td>
                                <td><button class="btn btn-xs btn-primary">Update</button></td>
                            </tr>
                            <tr>
                                <td>DailyTransferLimit</td>
                                <td>Max RUB transfer per day per user</td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <input type="text" class="form-control" value="100000">
                                        <span class="input-group-text">RUB</span>
                                    </div>
                                </td>
                                <td><button class="btn btn-xs btn-primary">Update</button></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

