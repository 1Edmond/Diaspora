@page "/"
@attribute [Authorize]
@inject NavigationManager NavigationManager

<PageTitle>Accueil | Diaspora Backoffice</PageTitle>

<PageBreadcrumb Title="Tableau de Bord" SubTitle="Centre de gestion des services" />

<div class="row">
    <div class="col-12">
        <div class="page-title-box">
            <div class="page-title-right">
                <button class="btn btn-primary" @onclick="RefreshData">
                    <i class="ti ti-refresh me-1"></i> Actualiser
                </button>
            </div>
            <h4 class="page-title">
                <i class="ti ti-apps me-2"></i>Centre de Services
            </h4>
        </div>
    </div>
</div>

<!-- Stats Cards -->
<div class="row">
    <div class="col-xl-3 col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="avatar-sm rounded-circle bg-primary-subtle text-primary">
                            <i class="ti ti-users fs-24"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h5 class="mb-1">@_stats.TotalUsers</h5>
                        <p class="text-muted mb-0">Utilisateurs</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="avatar-sm rounded-circle bg-success-subtle text-success">
                            <i class="ti ti-wallet fs-24"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h5 class="mb-1">@_stats.TotalTransactions</h5>
                        <p class="text-muted mb-0">Transactions</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="avatar-sm rounded-circle bg-warning-subtle text-warning">
                            <i class="ti ti-file-check fs-24"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h5 class="mb-1">@_stats.PendingKYC</h5>
                        <p class="text-muted mb-0">KYC en attente</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="avatar-sm rounded-circle bg-info-subtle text-info">
                            <i class="ti ti-briefcase fs-24"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h5 class="mb-1">@_stats.ActiveServices</h5>
                        <p class="text-muted mb-0">Services actifs</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Services Grid -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">
                    <i class="ti ti-grid-dots me-2"></i>Services Disponibles
                </h4>
                <p class="text-muted mb-0 mt-1">Cliquez sur un service pour y accéder</p>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    @foreach (var service in _services)
                    {
                        <div class="col-xl-4 col-md-6">
                            <div class="card service-card h-100 cursor-pointer" @onclick="() => NavigateToService(service.Route)">
                                <div class="card-body">
                                    <div class="d-flex align-items-start">
                                        <div class="flex-shrink-0">
                                            <div class="avatar-md rounded-circle @service.BgClass text-white d-flex align-items-center justify-content-center">
                                                <i class="ti @service.Icon fs-28"></i>
                                            </div>
                                        </div>
                                        <div class="flex-grow-1 ms-3">
                                            <h5 class="card-title mb-1">@service.Name</h5>
                                            <p class="text-muted mb-2">@service.Description</p>
                                            <div class="d-flex align-items-center">
                                                <span class="badge @service.StatusBadge me-2">@service.Status</span>
                                                @if (service.AlertCount > 0)
                                                {
                                                    <span class="badge bg-danger">@service.AlertCount alertes</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mt-3 pt-3 border-top">
                                        <div class="row text-center">
                                            <div class="col-4">
                                                <h6 class="mb-0">@service.Stats1</h6>
                                                <small class="text-muted">@service.Stats1Label</small>
                                            </div>
                                            <div class="col-4 border-start">
                                                <h6 class="mb-0">@service.Stats2</h6>
                                                <small class="text-muted">@service.Stats2Label</small>
                                            </div>
                                            <div class="col-4 border-start">
                                                <h6 class="mb-0">@service.Stats3</h6>
                                                <small class="text-muted">@service.Stats3Label</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Activity -->
<div class="row">
    <div class="col-xl-8">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">Activité Récente</h4>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-centered table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Utilisateur</th>
                                <th>Action</th>
                                <th>Date</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var activity in _recentActivities)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="flex-shrink-0">
                                                <div class="avatar-xs rounded-circle bg-soft-primary text-primary">
                                                    @(activity.UserName?[0] ?? '?')
                                                </div>
                                            </div>
                                            <div class="flex-grow-1 ms-2">
                                                @activity.UserName
                                            </div>
                                        </div>
                                    </td>
                                    <td>@activity.Action</td>
                                    <td>@activity.Date.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <span class="badge @activity.StatusClass">@activity.Status</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">Alertes</h4>
            </div>
            <div class="card-body">
                <div class="list-group list-group-flush">
                    @foreach (var alert in _alerts)
                    {
                        <div class="list-group-item px-0">
                            <div class="d-flex align-items-center">
                                <div class="flex-shrink-0">
                                    <div class="avatar-xs rounded-circle @alert.BgClass">
                                        <i class="ti @alert.Icon fs-14"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h6 class="mb-1">@alert.Title</h6>
                                    <p class="text-muted mb-0 fs-12">@alert.Message</p>
                                </div>
                                <div class="flex-shrink-0">
                                    <small class="text-muted">@alert.TimeAgo</small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .service-card {
        transition: all 0.3s ease;
    }
    .service-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }
    .cursor-pointer {
        cursor: pointer;
    }
</style>

