@page "/profile"
@attribute [Authorize]
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager

<PageTitle>Profils | Diaspora Backoffice</PageTitle>

<PageBreadcrumb Title="Gestion des Profils" SubTitle="Profils internes (Togo) et externes (Russie)" />

<!-- Stats -->
<div class="row mb-3">
    <div class="col-xl-3 col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="avatar-sm rounded-circle bg-primary-subtle text-primary">
                            <i class="ti ti-id fs-24"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h5 class="mb-1">@_stats.InternalTotal</h5>
                        <p class="text-muted mb-0">Profils Internes</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="avatar-sm rounded-circle bg-success-subtle text-success">
                            <i class="ti ti-globe fs-24"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h5 class="mb-1">@_stats.ExternalTotal</h5>
                        <p class="text-muted mb-0">Profils Externes</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="avatar-sm rounded-circle bg-warning-subtle text-warning">
                            <i class="ti ti-clock fs-24"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h5 class="mb-1">@_stats.PendingVerification</h5>
                        <p class="text-muted mb-0">En Attente</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="flex-shrink-0">
                        <div class="avatar-sm rounded-circle bg-info-subtle text-info">
                            <i class="ti ti-user-check fs-24"></i>
                        </div>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h5 class="mb-1">@_stats.Verified</h5>
                        <p class="text-muted mb-0">Vérifiés</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tabs -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <ul class="nav nav-tabs card-header-tabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(_activeTab == "internal" ? "active" : "")" 
                                @onclick='() => SwitchTab("internal")'>
                            <i class="ti ti-id me-1"></i> Profils Internes (Togo)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(_activeTab == "external" ? "active" : "")" 
                                @onclick='() => SwitchTab("external")'>
                            <i class="ti ti-globe me-1"></i> Profils Externes (Russie)
                        </button>
                    </li>
                </ul>
            </div>
            <div class="card-body">
                <!-- Internal Profiles Tab -->
                @if (_activeTab == "internal")
                {
                    <div class="tab-pane show active">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="d-flex gap-2">
                                <input type="text" class="form-control" placeholder="Rechercher..." 
                                       @bind="_internalSearch" @bind:event="oninput" />
                                <select class="form-select" style="width: 150px;" @bind="_internalStatusFilter">
                                    <option value="">Tous statuts</option>
                                    <option value="Pending">En attente</option>
                                    <option value="Verified">Vérifié</option>
                                    <option value="Rejected">Rejeté</option>
                                </select>
                            </div>
                            <button class="btn btn-success" @onclick="ShowCreateInternalModal">
                                <i class="ti ti-plus me-1"></i> Créer Profil Interne
                            </button>
                        </div>

                        @if (_isLoading)
                        {
                            <div class="text-center py-5">
                                <div class="spinner-border text-primary"></div>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-centered table-hover">
                                    <thead>
                                        <tr>
                                            <th>Nom</th>
                                            <th>Téléphone</th>
                                            <th>Date de Naissance</th>
                                            <th>Statut</th>
                                            <th>Vérifié le</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var profile in _internalProfiles)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="avatar-xs rounded-circle bg-soft-primary text-primary d-flex align-items-center justify-content-center me-2">
                                                            @(profile.FirstName?[0] ?? '?')
                                                        </div>
                                                        @profile.FirstName @profile.LastName
                                                    </div>
                                                </td>
                                                <td>@profile.PhoneNumber</td>
                                                <td>@profile.DateOfBirth.ToString("dd/MM/yyyy")</td>
                                                <td>
                                                    <span class="badge @GetInternalStatusBadge(profile.Status)">
                                                        @profile.Status
                                                    </span>
                                                </td>
                                                <td>
                                                    @(profile.VerifiedAt?.ToString("dd/MM/yyyy") ?? "-")
                                                </td>
                                                <td>
                                                    <div class="d-flex gap-1">
                                                        @if (profile.Status == "Pending")
                                                        {
                                                            <button class="btn btn-sm btn-success" @onclick="() => VerifyInternalProfile(profile.Id)">
                                                                <i class="ti ti-check"></i>
                                                            </button>
                                                        }
                                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewInternalDetails(profile)">
                                                            <i class="ti ti-eye"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                }

                <!-- External Profiles Tab -->
                @if (_activeTab == "external")
                {
                    <div class="tab-pane show active">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="d-flex gap-2">
                                <input type="text" class="form-control" placeholder="Rechercher..." 
                                       @bind="_externalSearch" @bind:event="oninput" />
                                <select class="form-select" style="width: 150px;" @bind="_externalKindFilter">
                                    <option value="">Tous types</option>
                                    <option value="Boursier">Boursier</option>
                                    <option value="Contractuel">Contractuel</option>
                                </select>
                                <select class="form-select" style="width: 150px;" @bind="_externalStatusFilter">
                                    <option value="">Tous statuts</option>
                                    <option value="Active">Actif</option>
                                    <option value="Suspended">Suspendu</option>
                                    <option value="PendingArrival">En attente</option>
                                </select>
                            </div>
                            <button class="btn btn-info" @onclick="ShowCreateExternalModal">
                                <i class="ti ti-plus me-1"></i> Créer Profil Externe
                            </button>
                        </div>

                        @if (_isLoading)
                        {
                            <div class="text-center py-5">
                                <div class="spinner-border text-primary"></div>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-centered table-hover">
                                    <thead>
                                        <tr>
                                            <th>ID Utilisateur</th>
                                            <th>Type</th>
                                            <th>Pays</th>
                                            <th>Statut</th>
                                            <th>Services</th>
                                            <th>Arrivée</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var profile in _externalProfiles)
                                        {
                                            <tr>
                                                <td>
                                                    <small class="text-muted">@profile.UserId.ToString()[..8]...</small>
                                                </td>
                                                <td>
                                                    <span class="badge @GetKindBadge(profile.Kind)">
                                                        @profile.Kind
                                                    </span>
                                                </td>
                                                <td>@profile.CountryName</td>
                                                <td>
                                                    <span class="badge @GetExternalStatusBadge(profile.Status)">
                                                        @profile.Status
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (profile.CanOfferServices)
                                                    {
                                                        <span class="badge bg-success"><i class="ti ti-check me-1"></i>Oui</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Non</span>
                                                    }
                                                </td>
                                                <td>
                                                    @(profile.ArrivalValidatedAt?.ToString("dd/MM/yyyy") ?? "-")
                                                </td>
                                                <td>
                                                    <div class="d-flex gap-1">
                                                        @if (profile.Status == "Active")
                                                        {
                                                            <button class="btn btn-sm btn-warning" @onclick="() => SuspendExternalProfile(profile.Id)">
                                                                <i class="ti ti-lock"></i>
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button class="btn btn-sm btn-success" @onclick="() => ActivateExternalProfile(profile.Id)">
                                                                <i class="ti ti-lock-open"></i>
                                                            </button>
                                                        }
                                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewExternalDetails(profile)">
                                                            <i class="ti ti-eye"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private HttpClient _client = default!;
    private string _activeTab = "internal";
    private bool _isLoading = true;

    // Data
    private List<InternalProfileViewModel> _internalProfiles = new();
    private List<ExternalProfileViewModel> _externalProfiles = new();

    // Stats
    private ProfileStats _stats = new();

    // Filters
    private string _internalSearch = "";
    private string _internalStatusFilter = "";
    private string _externalSearch = "";
    private string _externalKindFilter = "";
    private string _externalStatusFilter = "";

    protected override void OnInitialized()
    {
        _client = HttpClientFactory.CreateClient("GatewayClient");
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        try
        {
            InitializeMockData();
            CalculateStats();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Erreur: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void InitializeMockData()
    {
        _internalProfiles = new List<InternalProfileViewModel>
        {
            new InternalProfileViewModel
            {
                Id = Guid.NewGuid(),
                PhoneNumber = "+228 90 12 34 56",
                FirstName = "Koffi",
                LastName = "Mensah",
                DateOfBirth = new DateTime(1998, 5, 15),
                Status = "Pending",
                CreatedAt = DateTime.Now.AddMonths(-6)
            },
            new InternalProfileViewModel
            {
                Id = Guid.NewGuid(),
                PhoneNumber = "+228 90 23 45 67",
                FirstName = "Afi",
                LastName = "Kouassi",
                DateOfBirth = new DateTime(1995, 8, 22),
                Status = "Verified",
                VerifiedAt = DateTime.Now.AddMonths(-3),
                CreatedAt = DateTime.Now.AddMonths(-4)
            },
            new InternalProfileViewModel
            {
                Id = Guid.NewGuid(),
                PhoneNumber = "+228 90 34 56 78",
                FirstName = "Komi",
                LastName = "Agbé",
                DateOfBirth = new DateTime(2000, 3, 10),
                Status = "Pending",
                CreatedAt = DateTime.Now.AddMonths(-2)
            }
        };

        _externalProfiles = new List<ExternalProfileViewModel>
        {
            new ExternalProfileViewModel
            {
                Id = Guid.NewGuid(),
                UserId = Guid.NewGuid(),
                CountryName = "Russie",
                Kind = "Boursier",
                Status = "Active",
                CanOfferServices = true,
                ArrivalValidatedAt = DateTime.Now.AddMonths(-1),
                CreatedAt = DateTime.Now.AddMonths(-3)
            },
            new ExternalProfileViewModel
            {
                Id = Guid.NewGuid(),
                UserId = Guid.NewGuid(),
                CountryName = "Russie",
                Kind = "Contractuel",
                Status = "Active",
                CanOfferServices = true,
                ArrivalValidatedAt = DateTime.Now.AddMonths(-2),
                CreatedAt = DateTime.Now.AddMonths(-4)
            },
            new ExternalProfileViewModel
            {
                Id = Guid.NewGuid(),
                UserId = Guid.NewGuid(),
                CountryName = "Russie",
                Kind = "Boursier",
                Status = "PendingArrival",
                CanOfferServices = false,
                CreatedAt = DateTime.Now.AddDays(-15)
            }
        };
    }

    private void CalculateStats()
    {
        _stats.InternalTotal = _internalProfiles.Count;
        _stats.ExternalTotal = _externalProfiles.Count;
        _stats.PendingVerification = _internalProfiles.Count(p => p.Status == "Pending");
        _stats.Verified = _internalProfiles.Count(p => p.Status == "Verified");
    }

    private void SwitchTab(string tab)
    {
        _activeTab = tab;
    }

    private string GetInternalStatusBadge(string status)
    {
        return status switch
        {
            "Verified" => "bg-success",
            "Pending" => "bg-warning",
            "Rejected" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private string GetExternalStatusBadge(string status)
    {
        return status switch
        {
            "Active" => "bg-success",
            "Suspended" => "bg-warning",
            "PendingArrival" => "bg-info",
            "Deactivated" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private string GetKindBadge(string kind)
    {
        return kind switch
        {
            "Boursier" => "bg-primary",
            "Contractuel" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    private async Task VerifyInternalProfile(Guid id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Vérifier ce profil ?"))
            return;
        await JSRuntime.InvokeVoidAsync("alert", "Profil vérifié!");
    }

    private void ViewInternalDetails(InternalProfileViewModel profile) { }
    private void ShowCreateInternalModal() { }
    private void ShowCreateExternalModal() { }

    private async Task SuspendExternalProfile(Guid id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Suspendre ce profil ?"))
            return;
        await JSRuntime.InvokeVoidAsync("alert", "Profil suspendu!");
    }

    private async Task ActivateExternalProfile(Guid id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Activer ce profil ?"))
            return;
        await JSRuntime.InvokeVoidAsync("alert", "Profil activé!");
    }

    private void ViewExternalDetails(ExternalProfileViewModel profile) { }

    public class ProfileStats
    {
        public int InternalTotal { get; set; }
        public int ExternalTotal { get; set; }
        public int PendingVerification { get; set; }
        public int Verified { get; set; }
    }

    public class InternalProfileViewModel
    {
        public Guid Id { get; set; }
        public string PhoneNumber { get; set; } = string.Empty;
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public DateTime DateOfBirth { get; set; }
        public string Status { get; set; } = string.Empty;
        public DateTime? VerifiedAt { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    public class ExternalProfileViewModel
    {
        public Guid Id { get; set; }
        public Guid UserId { get; set; }
        public string CountryName { get; set; } = string.Empty;
        public string Kind { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public bool CanOfferServices { get; set; }
        public DateTime? ArrivalValidatedAt { get; set; }
        public DateTime CreatedAt { get; set; }
    }
}
