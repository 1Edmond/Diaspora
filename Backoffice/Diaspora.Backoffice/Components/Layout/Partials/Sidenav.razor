@rendermode InteractiveServer
@inject IJSRuntime JsRuntime;
@inject NavigationManager NavigationManager

<!-- Sidenav Menu Start -->
<div class="sidenav-menu">

    <!-- Brand Logo -->
    <a href="/" class="logo">
        <span class="logo logo-light">
            <span class="logo-lg"><h3 class="text-white mt-3">Diaspora</h3></span>
            <span class="logo-sm"><h3 class="text-white mt-3">D</h3></span>
        </span>

        <span class="logo logo-dark">
            <span class="logo-lg"><h3 class="text-dark mt-3">Diaspora</h3></span>
            <span class="logo-sm"><h3 class="text-dark mt-3">D</h3></span>
        </span>
    </a>

    <!-- Sidebar Hover Menu Toggle Button -->
    <button class="button-on-hover" @onclick="ToggleOnHoverSidebar">
        <i class="ti ti-menu-4 fs-22 align-middle"></i>
    </button>

    <!-- Full Sidebar Menu Close Button -->
    <button class="button-close-offcanvas">
        <i class="ti ti-x align-middle"></i>
    </button>

    <div class="scrollbar" data-simplebar>
        <!--- Sidenav Menu -->
        <ul class="side-nav">
            <li class="side-nav-title mt-2">Navigation</li>

            <li class="side-nav-item">
                <a href="/" class="side-nav-link">
                    <span class="menu-icon"><i class="ti ti-home"></i></span>
                    <span class="menu-text"> Dashboard </span>
                </a>
            </li>

            <li class="side-nav-title">Services</li>

            <li class="side-nav-item">
                <a href="/identity" class="side-nav-link">
                    <span class="menu-icon"><i class="ti ti-users"></i></span>
                    <span class="menu-text"> Identity </span>
                </a>
            </li>

            <li class="side-nav-item">
                <a href="/profile" class="side-nav-link">
                    <span class="menu-icon"><i class="ti ti-user-circle"></i></span>
                    <span class="menu-text"> Profile </span>
                </a>
            </li>

            <li class="side-nav-item">
                <a href="/kyc" class="side-nav-link">
                    <span class="menu-icon"><i class="ti ti-id"></i></span>
                    <span class="menu-text"> KYC </span>
                </a>
            </li>

            <li class="side-nav-item">
                <a href="/procedure" class="side-nav-link">
                    <span class="menu-icon"><i class="ti ti-list-check"></i></span>
                    <span class="menu-text"> Procedure </span>
                </a>
            </li>

            <li class="side-nav-item">
                <a href="/marketplace" class="side-nav-link">
                    <span class="menu-icon"><i class="ti ti-building-store"></i></span>
                    <span class="menu-text"> Marketplace </span>
                </a>
            </li>

            <li class="side-nav-item">
                <a href="/wallet" class="side-nav-link">
                    <span class="menu-icon"><i class="ti ti-wallet"></i></span>
                    <span class="menu-text"> Wallet & Bourse </span>
                </a>
            </li>

            <li class="side-nav-item">
                <a href="/document" class="side-nav-link">
                    <span class="menu-icon"><i class="ti ti-file-text"></i></span>
                    <span class="menu-text"> Document </span>
                </a>
            </li>

            <li class="side-nav-item">
                <a href="/chat" class="side-nav-link">
                    <span class="menu-icon"><i class="ti ti-message-circle"></i></span>
                    <span class="menu-text"> Chat </span>
                </a>
            </li>

            <li class="side-nav-item">
                <a href="/notification" class="side-nav-link">
                    <span class="menu-icon"><i class="ti ti-bell-ringing"></i></span>
                    <span class="menu-text"> Notification </span>
                </a>
            </li>

        </ul>
        <div class="clearfix"></div>
    </div>
</div>
<!-- Sidenav Menu End -->

@code {
    private async Task ToggleOnHoverSidebar()
    {
        await JsRuntime.InvokeVoidAsync("toggleOnHoverSidebar");
    }
}