@page "/layouts-horizontal"
@rendermode InteractiveServer
@inject IJSRuntime JsRuntime;

@using Ubold.Components.Layout
@layout HorizontalLayout

<PageBreadcrumb Title="Horizontal"/>


<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body text-center">
                <h4 class="m-0">Your custom content here</h4>
            </div> <!-- end card-body-->
        </div> <!-- end card-->
    </div> <!-- end col-->
</div>
<!-- end row-->

@code {

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JsRuntime.InvokeVoidAsync("updateHtmlAttributes", "data-layout", "topnav");
            await JsRuntime.InvokeVoidAsync("updateHtmlAttributes", "data-topbar-color", "dark");
            await JsRuntime.InvokeVoidAsync("updateHtmlAttributes", "data-menu-color", "light");
            await JsRuntime.InvokeVoidAsync("loadConfig");
            await JsRuntime.InvokeVoidAsync("loadApps");
        }
    }

}
